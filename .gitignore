# Checkout-local Rust toolchain and Cargo output
.tools/
target/

# Fixture working copies (scripts/extract-fixtures.sh extracts data/fixtures here)
data/raw/

# Generated captures, check output, and working README media
# (integration cases and capture scripts). Stills the README links live in
# docs/media/readme/ and are committed; everything else in docs/media/ is local.
review/
docs/media/*
!docs/media/README.md
!docs/media/readme/
!docs/media/readme/**

# Wrangler local state (site/ deploys)
.wrangler/

# Local working notes, never committed
PLAN.md
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules

# Agent files installed from the sibling wesleygrimes/agents monorepo.
# Never ship: marketplace review treats agent-control files as a listing blocker.
.cursor/

# Editor and tool state
.venv/
.agents/
.codex/
__pycache__/
*.qmlc
*.jsc
*.qmlls.ini

# Unpublished sharing copy and legacy derived data, kept local
docs/sharing.md
data/derived/

# Site media, cut from docs/media by the commands in site/README.md
site/take.mp4
site/take-poster.png

# mise per-machine overrides
mise.local.toml
